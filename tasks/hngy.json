{
  "name": "河南工业职业技术大学校园网登录",
  "description": "适用于河南工业职业技术大学认证页面（提交者描述为自研门户 ePortal 页面，无运营商选择、无验证码），需先点击密码占位元素激活真实输入框后再输入密码",
  "metadata": {
    "author": "fjy061129",
    "school": "河南工业职业技术大学",
    "device": "未知",
    "created": "2026-11-03"
  },
  "url": "{{LOGIN_URL}}",
  "timeout": 30000,
  "variables": {
    "username": "{{USERNAME}}",
    "password": "{{PASSWORD}}"
  },
  "steps": [
    {
      "id": "input_username",
      "type": "input",
      "description": "输入账号",
      "selector": "#username",
      "value": "{{username}}",
      "clear": true
    },
    {
      "id": "click_password_placeholder",
      "type": "click",
      "description": "点击密码占位元素，触发真实输入框显示",
      "selector": "#pwd_hk_posi"
    },
    {
      "id": "input_password",
      "type": "input",
      "description": "输入密码",
      "selector": "#pwd",
      "value": "{{password}}",
      "clear": true
    },
    {
      "id": "click_login_button",
      "type": "click",
      "description": "点击登录",
      "selector": "#loginLink_div"
    }
  ],
  "on_success": {
    "message": "登录成功"
  },
  "on_failure": {
    "message": "登录失败",
    "screenshot": true
  },
  "id": "hngy"
}
